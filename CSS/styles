*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Segoe UI",sans-serif;
}

body{
    background:linear-gradient(135deg,#f4f7fc 0%,#e8eefb 100%);
    min-height:100vh;
    padding:30px;
    color:#1f2937;
}

.hero{
    text-align:center;
    margin-bottom:30px;
}

.hero h1{
    font-size:2.6rem;
    font-weight:700;
    color:#0f172a;
}

.hero p{
    margin-top:10px;
    color:#64748b;
    font-size:1rem;
}

.container{
    display:grid;
    grid-template-columns:420px 1fr;
    gap:25px;
    align-items:start;
}

.panel{
    background:rgba(255,255,255,.92);
    backdrop-filter:blur(12px);
    border-radius:20px;
    padding:25px;
    box-shadow:
        0 10px 30px rgba(0,0,0,.08),
        0 1px 2px rgba(0,0,0,.04);
}

.panel h2{
    margin-bottom:20px;
    color:#0f172a;
}

.section-title{
    margin-top:20px;
    margin-bottom:10px;
    padding-bottom:6px;
    border-bottom:1px solid #e2e8f0;
    font-size:.95rem;
    font-weight:700;
    color:#2563eb;
}

label{
    display:block;
    margin-top:14px;
    margin-bottom:6px;
    font-weight:600;
    color:#334155;
}

input,
textarea,
select{
    width:100%;
    border:1px solid #dbe3f0;
    border-radius:12px;
    padding:12px 14px;
    font-size:14px;
    background:#fff;
    transition:.25s;
}

input:hover,
textarea:hover,
select:hover{
    border-color:#94a3b8;
}

input:focus,
textarea:focus,
select:focus{
    outline:none;
    border-color:#2563eb;
    box-shadow:0 0 0 4px rgba(37,99,235,.15);
}

textarea{
    min-height:90px;
    resize:vertical;
}

#copyBtn{
    width:100%;
    margin-top:25px;
    border:none;
    padding:14px;
    border-radius:14px;
    background:linear-gradient(
        135deg,
        #2563eb,
        #4f46e5
    );
    color:white;
    font-weight:600;
    font-size:15px;
    cursor:pointer;
    transition:.25s;
}

#copyBtn:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 20px rgba(79,70,229,.25);
}

#preview{
    min-height:600px;
    border:2px dashed #cbd5e1;
    border-radius:16px;
    background:#fafcff;
    padding:20px;
    overflow:auto;
}

#previewTitle{
    margin-bottom:15px;
}

.toast{
    position:fixed;
    right:25px;
    bottom:25px;
    display:flex;
    align-items:center;
    gap:15px;
    background:white;
    border-radius:16px;
    padding:16px 20px;
    box-shadow:0 15px 40px rgba(0,0,0,.15);
    transform:translateY(150%);
    transition:.35s ease;
    z-index:9999;
}

.toast.show{
    transform:translateY(0);
}

.toast-icon{
    font-size:30px;
}

.toast-title{
    font-weight:700;
}

.toast-message{
    font-size:14px;
    color:#64748b;
}

.toast-close{
    border:none;
    background:transparent;
    cursor:pointer;
    font-size:18px;
}

#helpButton{
    position:fixed;
    bottom:25px;
    right:25px;

    width:56px;
    height:56px;

    border-radius:50%;
    background:linear-gradient(
        135deg,
        #2563eb,
        #4f46e5
    );

    color:white;
    display:flex;
    align-items:center;
    justify-content:center;

    font-size:24px;
    font-weight:bold;

    cursor:pointer;

    box-shadow:0 10px 25px rgba(79,70,229,.30);
    transition:.25s;
    z-index:1000;
}

#helpButton:hover{
    transform:scale(1.08);
}

#helpPopup{
    position:fixed;
    right:25px;
    bottom:95px;
	
    width:340px;

    background:white;
    border-radius:20px;
    overflow:hidden;

    box-shadow:0 15px 40px rgba(0,0,0,.15);

    display:none;
    z-index:999;
}

.help-header{
    padding:15px;
    color:white;
    font-weight:600;
    background:linear-gradient(
        135deg,
        #2563eb,
        #4f46e5
    );
}

.help-content{
    padding:25px;
}

.help-content ul{
    margin-left:18px;
}

.help-content li{
    margin-bottom:8px;
}

@media(max-width:1100px){

    .container{
        grid-template-columns:1fr;
    }

    #preview{
        min-height:350px;
    }

}
